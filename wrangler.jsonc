{
  "name": "aisthara",
  "main": "src/index.js",
  "compatibility_date": "2026-08-23",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aisthara-db"
    }
  ],

  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "aisthara-images"
    }
  ]
}
